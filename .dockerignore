# Keep the Docker build context small: the server image only needs the workspace
# manifests, the lockfile and apps/server/src
**/node_modules
**/.next
**/.turbo
**/dist
.git
.claude
.superpowers
docs
design-system

# Secrets come from the host's environment settings, never the image
**/.env
**/.env.*
!**/.env.example

# Only the web app's package.json is needed (for the workspace lockfile)
apps/web/*
!apps/web/package.json
