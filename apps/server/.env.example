CORS_ORIGIN=http://localhost:3001

# Supabase configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hugging Face API for chat/plan generation
HUGGINGFACE_API_TOKEN=
HF_TEXT_MODEL=
HF_TIMEOUT_MS=

# Embedding OpenAI (text-embedding-3-small)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional: use another OpenAI-compatible provider instead (overrides the OPENAI_* values).
# Gemini free tier (key from https://aistudio.google.com/apikey):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-3.5-flash-lite   # 2.5 Flash is closed to new users; 3.5 Flash leaks reasoning under small token caps
#   LLM_EMBED_MODEL=gemini-embedding-001
#   LLM_EMBED_DIMENSIONS=1536   # must match the vector(1536) column
#   LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash   # tried in order on 429 (quotas are per model)
# After changing the embedding model run `bun run db:embed --all`.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_EMBED_MODEL=
LLM_EMBED_DIMENSIONS=
LLM_FALLBACK_MODELS=

# Chat Config
CHAT_SYSTEM_PROMPT=You are TripPlannerAI, an expert travel assistant.\n- Use only the provided candidate places (DB-backed). Do not invent.\n- Output JSON only, no markdown or extra text.
CHAT_ALWAYS_NO_MATCH=false